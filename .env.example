# CareAuth-ROCm Environment Variables Template
# NEVER COMMIT YOUR REAL API KEYS TO GITHUB

# AMD Cloud Endpoint (From AMD AI Developer Program / Cloud Instance)
AMD_ROCM_ENDPOINT=http://<your-amd-cloud-instance-ip>:8000/v1
AMD_API_KEY=your_amd_api_key_here
AMD_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# Evolus Partner Track Platform (From app.evolus.ai Settings -> API Keys)
EVOLUS_API_KEY=your_evolus_api_key_here
EVOLUS_WORKSPACE_ID=your_evolus_workspace_id_here
EVOLUS_BASE_URL=https://api.evolus.ai/v1

# Operational Mode
# Set to 'false' when connecting to live AMD Cloud / Evolus endpoints
USE_OFFLINE_MOCK=false
